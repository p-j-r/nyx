# Workflow 2 (P0): the same wire, ten wavelengths 1500 to 1590 nm by hand, one physics: set the study, solve, read neff.
# The geometry does not change, so the mesh is the cached one after the first solve; what a sweep could reuse beyond that is not.
{"cmd":"project_open","args":{"path":"examples/15_soi_wire.nyx.json"},"note":"open the SOI wire"}
{"cmd":"set_study","args":{"physics":"ems","kind":"modes","params":{"freq":199861638666666.66,"n_modes":2,"n_target":2.75}},"note":"wavelength 1500 nm"}
{"cmd":"solve_run","note":"mesh (cached) + solve"}
{"cmd":"result_info","args":{"physics":"ems"},"note":"read neff"}
