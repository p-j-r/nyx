nyx.nyxems --> nyx.nyxphysics <<Relationship-UmVsYXRpb25zaGlw>> : "Implements Physics\n<size:16>[Rust API]</size>"
nyx.nyxdfs --> nyx.femcore <<Relationship-UmVsYXRpb25zaGlw>> : "Mesh, assembly, linear algebra\n<size:16>[Rust API]</size>"
nyx.nyxsms --> nyx.femcore <<Relationship-UmVsYXRpb25zaGlw>> : "Mesh, assembly, linear algebra\n<size:16>[Rust API]</size>"
