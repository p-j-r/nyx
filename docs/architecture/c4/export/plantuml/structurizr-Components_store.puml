    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Container,Store
  .Element-RWxlbWVudCxDb250YWluZXIsU3RvcmU= {
    BackgroundColor: #438dd5;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #444444;
    FontColor: #444444;
    FontSize: 24;
  }
  // nyx
  .Boundary-bnl4 {
    BackgroundColor: #ffffff;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
  // nyx-store
  .Boundary-bnl4LXN0b3Jl {
    BackgroundColor: #ffffff;
    LineColor: #2e6295;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "nyx\n<size:16>[Software System]</size>" <<Boundary-bnl4>> {
  rectangle "nyx-store\n<size:16>[Container: Rust library]</size>" <<Boundary-bnl4LXN0b3Jl>> {
    rectangle "==Data model and card\n<size:16>[Component: Rust modules]</size>\n\nThe workflow manifest, experiments, run digest and the concept card generated from an experiment's spec." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as nyx.nyxstore.Datamodelandcard
    rectangle "==Workspace\n<size:16>[Component: Rust modules]</size>\n\nThe folder behind the dashboard: settings, the list of workflows (manifests only) and the sections of the dashboard." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as nyx.nyxstore.Workspace
    rectangle "==Workflow folder\n<size:16>[Component: Rust modules]</size>\n\nOne workflow folder: workflow.json, history.jsonl, notes, specs and one folder per experiment." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as nyx.nyxstore.Workflowfolder
    rectangle "==Versions\n<size:16>[Component: Rust modules]</size>\n\nEvery change to an experiment's set-up kept in history.jsonl with the hash of its spec." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as nyx.nyxstore.Versions
    rectangle "==Runs\n<size:16>[Component: Rust modules]</size>\n\nAppend-only run records in runs.jsonl, the digest derived from them and the filter language of the runs table." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as nyx.nyxstore.Runs
    rectangle "==Search\n<size:16>[Component: Rust modules]</size>\n\nSearch over the manifests: plain words with a synonym table and numbers with units matched against card dimensions." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as nyx.nyxstore.Search
    rectangle "==Archives\n<size:16>[Component: Rust modules]</size>\n\n.nyx files: a workflow as one deterministic ZIP and the safe way back in." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as nyx.nyxstore.Archives
    rectangle "==Utilities\n<size:16>[Component: Rust modules]</size>\n\nUTC time without a time crate, time-ordered ids, atomic file writes, hashes and slugs." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as nyx.nyxstore.Utilities
  }

  database "==Workspace data\n<size:16>[Container: Files and folders]</size>\n\nworkspace.json, workflow.json, history.jsonl, runs.jsonl, specs/ (experiment.nyx.json, specs/<hash>.nyx.json), run folders with results.h5, .nyx archives." <<Element-RWxlbWVudCxDb250YWluZXIsU3RvcmU=>> as nyx.Workspacedata
}

