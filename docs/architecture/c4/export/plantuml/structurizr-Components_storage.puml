rectangle "nyx\n<size:16>[Software System]</size>" <<Boundary-bnl4>> {
  rectangle "nyx-storage\n<size:16>[Container: Rust library]</size>" <<Boundary-bnl4LXN0b3JhZ2U=>> {
    rectangle "==Storage types and read budget\n<size:16>[Component: Rust modules]</size>\n\nFieldStorageLayout (L1 Deflate-3, L2 Shuffle+LZF packed 5D, L3 Contiguous packed 5D), ReadBudgetConfig (512 MiB default ceiling), MeshData, ModeHeader, PackedComponentMeta and bitwise f64 verification helpers." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as nyx.nyxstorage.Storagetypesandreadbudget
    rectangle "==Streaming HDF5 reader\n<size:16>[Component: Rust modules]</size>\n\nBounded-memory streaming reader over hdf5_pure::File::open_streaming: checked_mul read-budget guards, O(1) mode-header scan, mesh reader (with optional curved edges), and transparent single-mode cell-field slicing across L2/L3 packed 5D and legacy L1/v3 files." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as nyx.nyxstorage.StreamingHDF5reader
    rectangle "==Packed and streaming HDF5 writer\n<size:16>[Component: Rust modules]</size>\n\nWhole-file atomic writer (write_nyx_packed) and bounded-RSS incremental mode-by-mode streaming appender (init_nyx_packed_streaming, append_solved_mode_in_place via File::open_rw and append_staged)." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as nyx.nyxstorage.PackedandstreamingHDF5writer
    rectangle "==Direct-path XDMF generator\n<size:16>[Component: Rust modules]</size>\n\nDirect-path XDMF 3.0 XML companion generator (generate_direct_xdmf, write_direct_xdmf) referencing internal HDF5 dataset paths without /viz hard links." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as nyx.nyxstorage.DirectpathXDMFgenerator
    rectangle "==Sweep checkpoint and atomic IO\n<size:16>[Component: Rust modules]</size>\n\nIncremental in-place parameter-sweep checkpointing (SweepCheckpoint over unlimited chunked datasets via File::open_rw) and Windows NTFS atomic file replacement helpers." <<Element-RWxlbWVudCxDb21wb25lbnQ=>> as nyx.nyxstorage.SweepcheckpointandatomicIO
  }

  database "==Results file\n<size:16>[Container: File .h5 and .xdmf]</size>\n\nProject, mesh and every solution of every solved physics, compressed (packed 5D Shuffle+LZF or Deflate), exact; with an XDMF description next to it." <<Element-RWxlbWVudCxDb250YWluZXIsU3RvcmU=>> as nyx.Resultsfile
}

