person "==Researcher\n<size:16>[Person]</size>\n\nDesigns waveguides, rings and phononic cells; runs mode and eigenfrequency studies; compares runs." <<Element-RWxlbWVudCxQZXJzb24=>> as Researcher
rectangle "==AI host\n<size:16>[Software System]</size>\n\nClaude Code or Claude Desktop (any MCP host). Drives nyx through the engine commands as MCP tools." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw=>> as AIhost
rectangle "==Results viewer\n<size:16>[Software System]</size>\n\nParaView or VisIt. Reads the XDMF description and the HDF5 results file." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw=>> as Resultsviewer
database "==Workspace folder\n<size:16>[Software System]</size>\n\nDocuments/nyx on disk: workflows, runs, .nyx archives, project files." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWwsU3RvcmU=>> as Workspacefolder
rectangle "==nyx\n<size:16>[Software System]</size>\n\nGeometry, meshing, finite-element solvers and result analysis for wave problems in wafer-based devices." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as nyx

Researcher --> nyx <<Relationship-UmVsYXRpb25zaGlw>> : "Edits models, runs studies, reads results"
Researcher --> AIhost <<Relationship-UmVsYXRpb25zaGlw>> : "Asks in words"
AIhost --> nyx <<Relationship-UmVsYXRpb25zaGlw>> : "Calls tools\n<size:16>[MCP over stdio (JSON-RPC 2.0)]</size>"
Resultsviewer --> nyx <<Relationship-UmVsYXRpb25zaGlw>> : "Reads\n<size:16>[XDMF / HDF5]</size>"
nyx --> Workspacefolder <<Relationship-UmVsYXRpb25zaGlw>> : "Reads and writes"

@enduml