{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nyx.dev/contracts/install_report.v1.schema.json",
  "title": "install_report.v1",
  "description": "Machine-readable report printed by `nyx-setup <action> --json`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "ok",
    "action",
    "dry_run",
    "scope",
    "install_root",
    "manifest_path",
    "nyx_version",
    "previous_version",
    "files_written",
    "files_removed",
    "path_updated",
    "desktop_updated",
    "file_assoc_updated",
    "ai_hosts",
    "doctor_checks",
    "warnings",
    "errors",
    "next_steps"
  ],
  "properties": {
    "schema": {
      "enum": [
        "nyx-install.install",
        "nyx-install.upgrade",
        "nyx-install.repair",
        "nyx-install.uninstall",
        "nyx-install.status",
        "nyx-install.doctor"
      ]
    },
    "version": {
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "action": {
      "enum": [
        "install",
        "upgrade",
        "repair",
        "uninstall",
        "status",
        "doctor"
      ]
    },
    "dry_run": {
      "type": "boolean"
    },
    "scope": {
      "enum": [
        "user",
        "system",
        "custom"
      ]
    },
    "install_root": {
      "type": "string"
    },
    "manifest_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "nyx_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "previous_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "files_written": {
      "type": "integer"
    },
    "files_removed": {
      "type": "integer"
    },
    "path_updated": {
      "type": "boolean"
    },
    "desktop_updated": {
      "type": "boolean"
    },
    "file_assoc_updated": {
      "type": "boolean"
    },
    "ai_hosts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/host_outcome"
      }
    },
    "doctor_checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/doctor_check"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "host_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "action",
        "status",
        "config_path",
        "backup_path",
        "detail"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "config_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "backup_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "doctor_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tier",
        "status",
        "detail"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "tier": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "status": {
          "enum": [
            "ok",
            "warn",
            "fail",
            "info"
          ]
        },
        "detail": {
          "type": "string"
        }
      }
    }
  }
}
